#!/usr/bin/env bash
# rc-notify EVENT — send a notification event to the host-side listener.
#
# introdus bind-mounts the host endpoint at /run/notify. Its type depends on
# the host OS:
#   - Linux: a FIFO. Some kernels refuse to let a process in the container's
#     mount/user namespace connect() to a bind-mounted unix socket even when
#     ownership/permissions and the LSM all allow it; writing to a bind-mounted
#     FIFO has no such restriction.
#   - macOS: a unix socket. The endpoint is shared into the podman VM over
#     virtiofs, and a FIFO's pipe buffer would not cross that VM boundary.
#
# So detect the type and write accordingly. This is best-effort: it never
# blocks a Claude hook for more than a few seconds and never fails the hook,
# even if the listener is absent.
set -u

EVENT="${1:-done}"
# The host endpoint introdus bind-mounts. Overridable only so the unit test can
# point it at a scratch path: the pre-commit `cargo test` often runs inside a dev
# container where /run/notify is a LIVE FIFO, and an un-redirectable target would
# fire a real desktop notification (or block on `timeout 5`) on every commit.
# Not a trust boundary — the workload already chooses the event text it sends,
# and the host re-validates everything it reads (see core::notify).
TARGET="${RC_NOTIFY_TARGET:-/run/notify}"

# Tag the event with this container's identity so the host (especially when one
# host relays many containers' notifications) can show WHICH container finished.
# PROJECT_NAME is injected by introdus; RC_LABEL can override it. The wire
# format is "event<TAB>label"; the host re-validates the event and sanitizes
# the label, so anything we send here is treated as untrusted there.
LABEL="${RC_LABEL:-${PROJECT_NAME:-}}"
if [[ -n "$LABEL" ]]; then
    MSG="${EVENT}"$'\t'"${LABEL}"
else
    MSG="${EVENT}"
fi

if [[ -S "$TARGET" ]]; then
    # unix socket (macOS host)
    printf '%s\n' "$MSG" | timeout 5 nc -U "$TARGET" 2>/dev/null || true
elif [[ -p "$TARGET" ]]; then
    # FIFO (Linux host). Opening for write blocks until the listener is reading;
    # timeout caps the wait so a missing reader can't wedge the hook.
    timeout 5 bash -c 'printf "%s\n" "$1" > "$2"' _ "$MSG" "$TARGET" 2>/dev/null || true
fi

# ---- paseo terminal activity (phone push) -----------------------------------
# When this hook runs inside a terminal the paseo daemon spawned, also report the
# state to paseo so its app/phone gets a "Terminal needs input"/"Terminal
# finished" push. paseo injects PASEO_TERMINAL_ID (plus an activity token/URL)
# into those terminals only, so this is a no-op everywhere else — an ordinary
# `run-claude` tmux window keeps the host FIFO as its only path.
#
# We report instead of letting paseo install its OWN claude hooks (its
# `enableTerminalAgentHooks` daemon setting, default off) because that mapping
# only treats an `idle_prompt` Notification as "needs input" and registers no
# PermissionRequest hook at all — so a claude permission prompt would raise
# nothing. rc-notify already fires on exactly the right events, so it reports
# both: `waiting` is fed paseo's `idle_prompt` sentinel on stdin (the only shape
# its claude handler resolves to needs-input), `done` maps to Stop → idle.
#
# The POST goes to the daemon's own listener (no egress), and `paseo hooks` caps
# it at 500ms. Best-effort like the FIFO write above: never fails the hook.
PASEO_CLI="${PASEO_HOOK_CLI:-paseo}"
if [[ -n "${PASEO_TERMINAL_ID:-}" ]] && command -v "$PASEO_CLI" >/dev/null 2>&1; then
    case "$EVENT" in
        waiting)
            printf '{"reason":"idle_prompt"}' \
                | timeout 5 "$PASEO_CLI" hooks claude Notification >/dev/null 2>&1 || true
            ;;
        done)
            timeout 5 "$PASEO_CLI" hooks claude Stop </dev/null >/dev/null 2>&1 || true
            ;;
    esac
fi

exit 0
